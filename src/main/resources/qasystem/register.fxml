<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="qasystem.controller.RegisterController">
   <content>
      <StackPane styleClass="auth-root">
         <children>
            <VBox styleClass="auth-card" maxWidth="480.0" maxHeight="-Infinity">
               <children>
                  <Label text="Q&amp;A SYSTEM" styleClass="auth-brand" />
                  <Label text="Create your account" styleClass="auth-title" />
                  <Label text="Join as a student - or enter an invite code if an admin gave you one."
                         styleClass="auth-subtitle" wrapText="true" minHeight="-Infinity" />

                  <Label text="Username" styleClass="field-label" />
                  <TextField fx:id="usernameField" promptText="At least 3 characters, no spaces" />

                  <Label text="Password" styleClass="field-label" />
                  <PasswordField fx:id="passwordField" promptText="Choose a strong password" />
                  <VBox fx:id="passwordRulesBox" />

                  <Label text="Confirm password" styleClass="field-label" />
                  <PasswordField fx:id="confirmPasswordField" promptText="Type it again" />
                  <Label fx:id="matchLabel" />

                  <Label text="Invite code (optional)" styleClass="field-label" />
                  <TextField fx:id="inviteCodeField" promptText="Leave blank to join as a student" />

                  <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" minHeight="-Infinity" />
                  <Button text="Create Account" defaultButton="true" maxWidth="Infinity"
                          mnemonicParsing="false" onAction="#createAccount" styleClass="primary-button,big-button" />

                  <HBox alignment="CENTER" spacing="4.0" style="-fx-padding: 8 0 0 0;">
                     <children>
                        <Label text="Already have an account?" styleClass="auth-subtitle" />
                        <Button text="Log in" mnemonicParsing="false" onAction="#backToLogin" styleClass="link-button" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </content>
</ScrollPane>
