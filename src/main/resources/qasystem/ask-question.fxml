<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="qasystem.controller.AskQuestionController">

   <top>
      <HBox styleClass="top-bar">
         <children>
            <Button text="&#8592;  Cancel" mnemonicParsing="false" onAction="#cancel" />
            <Label text="Q&amp;A" styleClass="brand-accent" />
            <Label text="SYSTEM" styleClass="brand" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </top>

   <center>
      <VBox styleClass="page">
         <children>
            <Label fx:id="courseLabel" styleClass="breadcrumb" />
            <Label text="Ask a question" styleClass="hero-title" />

            <HBox spacing="24.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Left: the question -->
                  <VBox styleClass="panel" HBox.hgrow="ALWAYS" prefWidth="640.0">
                     <children>
                        <Label text="Chapter" styleClass="field-label" style="-fx-padding: 0;" />
                        <ComboBox fx:id="chapterChoice" maxWidth="Infinity" />

                        <Label text="Title" styleClass="field-label" />
                        <TextField fx:id="titleField" promptText="Summarize your question in one line" />

                        <Label text="Details (optional)" styleClass="field-label" />
                        <TextArea fx:id="bodyArea" prefRowCount="6" wrapText="true" VBox.vgrow="ALWAYS"
                                  promptText="What have you tried? Where exactly are you stuck?" />

                        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" minHeight="-Infinity" />
                        <Button fx:id="submitButton" text="Post Question" mnemonicParsing="false"
                                onAction="#submit" styleClass="primary-button,big-button" />
                     </children>
                  </VBox>

                  <!-- Right: similar questions, updated as you type -->
                  <VBox styleClass="panel" prefWidth="460.0" minWidth="360.0">
                     <children>
                        <Label text="Before you ask" styleClass="section-title" style="-fx-padding: 0;" />
                        <Label fx:id="relatedHeader" styleClass="hero-subtitle" wrapText="true" minHeight="-Infinity" />
                        <ListView fx:id="relatedList" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
