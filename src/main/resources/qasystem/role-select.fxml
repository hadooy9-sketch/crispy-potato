<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="auth-root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="qasystem.controller.RoleSelectController">
   <children>
      <VBox styleClass="auth-card" maxWidth="940.0" maxHeight="-Infinity" spacing="10.0">
         <children>
            <Label text="Q&amp;A SYSTEM" styleClass="auth-brand" />
            <Label fx:id="welcomeLabel" styleClass="auth-title" />
            <Label text="You have more than one role. Choose how you want to use the system right now - log out any time to switch."
                   styleClass="auth-subtitle" wrapText="true" minHeight="-Infinity" />
            <!-- One card per role, added by RoleSelectController.initialize() -->
            <FlowPane fx:id="roleBox" hgap="18.0" vgap="18.0" style="-fx-padding: 18 0 10 0;" />
            <Button text="Log Out" mnemonicParsing="false" onAction="#logout" styleClass="link-button" />
         </children>
      </VBox>
   </children>
</StackPane>
