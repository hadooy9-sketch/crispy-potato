<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="auth-root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="qasystem.controller.LoginController">
   <children>
      <VBox styleClass="auth-card" maxWidth="460.0" maxHeight="-Infinity">
         <children>
            <Label text="Q&amp;A SYSTEM" styleClass="auth-brand" />
            <Label text="Welcome back" styleClass="auth-title" />
            <Label text="Log in to ask, answer, and review questions." styleClass="auth-subtitle" wrapText="true" minHeight="-Infinity" />

            <Label text="Username" styleClass="field-label" />
            <TextField fx:id="usernameField" promptText="Your username" />

            <Label text="Password" styleClass="field-label" />
            <PasswordField fx:id="passwordField" promptText="Your password" />

            <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" minHeight="-Infinity" />
            <Button fx:id="loginButton" text="Log In" defaultButton="true" maxWidth="Infinity"
                    mnemonicParsing="false" onAction="#login" styleClass="primary-button,big-button" />

            <HBox alignment="CENTER" spacing="4.0" style="-fx-padding: 8 0 0 0;">
               <children>
                  <Label text="New here?" styleClass="auth-subtitle" />
                  <Button text="Create an account" mnemonicParsing="false" onAction="#goToRegister" styleClass="link-button" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
