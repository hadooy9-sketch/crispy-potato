<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="qasystem.controller.CourseViewController">

   <top>
      <HBox styleClass="top-bar">
         <children>
            <Button text="&#8592;  Back" mnemonicParsing="false" onAction="#back" styleClass="back-button" />
            <Label text="Q&amp;A" styleClass="brand-accent" />
            <Label text="SYSTEM" styleClass="brand" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="followButton" mnemonicParsing="false" onAction="#toggleFollow" />
            <Button fx:id="deleteCourseButton" text="Delete Course" mnemonicParsing="false"
                    onAction="#deleteCourse" styleClass="danger-button" />
         </children>
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true">
         <content>
            <VBox styleClass="page">
               <children>
                  <Label fx:id="courseCodeLabel" styleClass="hero-code" />
                  <Label fx:id="courseTitleLabel" styleClass="hero-title" wrapText="true" minHeight="-Infinity" />
                  <Label fx:id="courseSubtitleLabel" styleClass="hero-subtitle" wrapText="true" minHeight="-Infinity"
                         text="Ask anything about this course, or pick a chapter to see its questions." />

                  <!-- The "ask" banner: asking and the open questions, filled in by CourseViewController -->
                  <HBox fx:id="askBanner" styleClass="ask-banner" alignment="CENTER_LEFT" spacing="18.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="askTitleLabel" styleClass="ask-banner-title" wrapText="true" minHeight="-Infinity" />
                              <Label fx:id="askSubtitleLabel" styleClass="ask-banner-subtitle" wrapText="true" minHeight="-Infinity" />
                           </children>
                        </VBox>
                        <Button fx:id="openQuestionsButton" mnemonicParsing="false" onAction="#openQuestions"
                                styleClass="secondary-button" minWidth="-Infinity" />
                        <Button fx:id="askButton" text="+  Ask a Question" mnemonicParsing="false" onAction="#askQuestion"
                                styleClass="primary-button,shortcut-ask" minWidth="-Infinity" />
                     </children>
                  </HBox>

                  <Label text="Chapters" styleClass="section-title" />
                  <!-- Chapter cards (and the + card for admins) added by CourseViewController -->
                  <FlowPane fx:id="chaptersPane" hgap="18.0" vgap="18.0" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
